<%- include('partials/header') %>

<%# Страница ошибки: пользовательское описание без системных сообщений и стека %>
<section class="error-page">
  <div class="error-code"><%= status %></div>
  <h1><%= errorTitle %></h1>
  <p class="lead"><%= message %></p>
  <% if (hint) { %><p class="muted"><%= hint %></p><% } %>

  <dl class="detail-grid error-info">
    <div><dt>Код ошибки</dt><dd class="mono">#<%= errorId %></dd></div>
    <div><dt>Время</dt><dd class="mono"><%= formatDate(time) %></dd></div>
    <div><dt>Запрос</dt><dd class="mono"><%= method %> <%= url %></dd></div>
    <div><dt>Журнал ошибок</dt><dd><%= logged ? 'ошибка записана в logs/errors.log' : 'журнал недоступен, ошибка выведена в консоль сервера' %></dd></div>
  </dl>

  <div class="actions">
    <a class="btn" href="/">На главную</a>
    <% if (method === 'GET') { %><a class="btn btn-ghost" href="<%= url %>">Повторить запрос</a><% } %>
  </div>
</section>

<%- include('partials/footer') %>
